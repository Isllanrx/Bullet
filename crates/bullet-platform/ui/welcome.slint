import { Theme, ExposeLayer, GoldButton, Diamond, Wordmark, Halo, Surface } from "theme.slint";

export component WelcomeWindow inherits Window {
    in property <bool> expose-flip;
    in property <string> version;
    in property <string> pill;
    in property <[string]> items;
    in property <string> dismiss-label;
    in property <string> project-label;
    callback dismiss();
    callback open-project();
    property <bool> shown;
    title: "Bullet — League of Legends Skin Changer";
    icon: @image-url("assets/logo.png");
    preferred-width: 530px;
    preferred-height: 440px;
    min-width: 420px;
    min-height: 340px;
    background: Theme.backdrop;
    default-font-family: Theme.sans;
    forward-focus: keys;
    init => { root.shown = true; }

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape || event.text == Key.Return {
                root.dismiss();
                return accept;
            }
            reject
        }
    }

    content := VerticalLayout {
        y: root.shown ? 0px : 8px;
        opacity: root.shown ? 1 : 0;
        animate opacity, y { duration: Theme.dur-slow; easing: ease-out; }
        padding-left: 28px;
        padding-right: 28px;
        padding-top: 22px;
        padding-bottom: 24px;
        spacing: 14px;
        Rectangle {
            height: 72px;
            Halo {
                x: -72px;
                y: -64px;
            }
            HorizontalLayout {
                spacing: 16px;
                Image {
                    source: @image-url("assets/logo-56.png");
                    width: 56px;
                    height: 56px;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 5px;
                    Wordmark {
                        version: root.version;
                        size: 11px;
                    }
                    Text {
                        text: "League of Legends Skin Changer";
                        color: Theme.gold-bright;
                        font-family: Theme.serif;
                        font-size: 20px;
                        font-weight: 700;
                        overflow: elide;
                    }
                }
            }
        }
        Surface {
            vertical-stretch: 1;
            VerticalLayout {
                padding-top: 16px;
                padding-bottom: 16px;
                padding-left: 20px;
                padding-right: 20px;
                spacing: 9px;
                alignment: start;
                HorizontalLayout {
                    alignment: start;
                    padding-bottom: 3px;
                    Rectangle {
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.cyan.with-alpha(0.25);
                        background: Theme.cyan.with-alpha(0.08);
                        HorizontalLayout {
                            padding-left: 7px;
                            padding-right: 10px;
                            padding-top: 3px;
                            padding-bottom: 3px;
                            spacing: 7px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 6px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: Theme.cyan;
                                    drop-shadow-blur: 4px;
                                    drop-shadow-color: Theme.cyan;
                                }
                            }
                            Text {
                                text: root.pill;
                                color: Theme.cyan;
                                font-size: Theme.text-sm;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                for item in root.items: HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        padding-top: 4px;
                        Diamond { }
                    }
                    Text {
                        text: item;
                        color: Theme.text;
                        font-size: Theme.text-base;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
            }
        }
        HorizontalLayout {
            alignment: center;
            spacing: 12px;
            GoldButton {
                width: 190px;
                min-height: 40px;
                horizontal-stretch: 0;
                primary: true;
                font-size: Theme.text-base;
                text: root.dismiss-label;
                clicked => { root.dismiss(); }
            }
            if root.project-label != "": GoldButton {
                hug: true;
                min-height: 40px;
                horizontal-stretch: 0;
                font-size: Theme.text-base;
                text: root.project-label;
                clicked => { root.open-project(); }
            }
        }
    }

    ExposeLayer {
        flip: root.expose-flip;
    }
}

export component NoticeDialog inherits Window {
    in property <bool> expose-flip;
    in property <string> version;
    in property <int> kind;
    in property <string> badge;
    in property <string> heading;
    in property <string> body;
    in property <string> confirm-label;
    in property <string> cancel-label;
    callback confirm();
    callback cancel();
    property <bool> shown;
    title: root.heading != "" ? root.heading : "Bullet";
    icon: @image-url("assets/logo.png");
    preferred-width: 470px;
    preferred-height: 310px;
    min-width: 380px;
    min-height: 240px;
    background: Theme.backdrop;
    default-font-family: Theme.sans;
    forward-focus: keys;
    init => { root.shown = true; }

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return {
                root.confirm();
                return accept;
            }
            if event.text == Key.Escape {
                if root.cancel-label != "" {
                    root.cancel();
                } else {
                    root.confirm();
                }
                return accept;
            }
            reject
        }
    }

    VerticalLayout {
        y: root.shown ? 0px : 8px;
        opacity: root.shown ? 1 : 0;
        animate opacity, y { duration: Theme.dur-slow; easing: ease-out; }
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 20px;
        padding-bottom: 22px;
        spacing: 14px;
        Rectangle {
            height: 60px;
            Halo {
                x: -64px;
                y: -60px;
                size: 180px;
            }
            HorizontalLayout {
                spacing: 14px;
                Image {
                    source: @image-url("assets/logo-40.png");
                    width: 42px;
                    height: 42px;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    Wordmark {
                        version: root.version;
                        size: 11px;
                    }
                    Text {
                        text: root.heading;
                        color: Theme.gold-bright;
                        font-family: Theme.serif;
                        font-size: 17px;
                        font-weight: 700;
                        wrap: word-wrap;
                    }
                }
            }
        }
        Surface {
            vertical-stretch: 1;
            border-color: root.kind == 1 ? #6b2b32 : root.kind == 2 ? Theme.gold-dim : Theme.surface-line;
            VerticalLayout {
                padding-top: 14px;
                padding-bottom: 14px;
                padding-left: 18px;
                padding-right: 18px;
                spacing: 10px;
                alignment: start;
                if root.badge != "": HorizontalLayout {
                    alignment: start;
                    Rectangle {
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: root.kind == 1 ? Theme.danger.with-alpha(0.45) : root.kind == 2 ? Theme.gold.with-alpha(0.4) : Theme.cyan.with-alpha(0.3);
                        background: root.kind == 1 ? Theme.danger.with-alpha(0.12) : root.kind == 2 ? Theme.gold.with-alpha(0.1) : Theme.cyan.with-alpha(0.08);
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 10px;
                            padding-top: 3px;
                            padding-bottom: 3px;
                            spacing: 6px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 6px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: root.kind == 1 ? Theme.danger : root.kind == 2 ? Theme.gold : Theme.cyan;
                                }
                            }
                            Text {
                                text: root.badge;
                                color: root.kind == 1 ? Theme.danger-text : root.kind == 2 ? Theme.gold-bright : Theme.cyan;
                                font-size: Theme.text-xs;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                Text {
                    text: root.body;
                    color: Theme.text;
                    font-size: Theme.text-base;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 10px;
            if root.cancel-label != "": GoldButton {
                hug: true;
                min-width: 112px;
                min-height: 36px;
                horizontal-stretch: 0;
                font-size: Theme.text-md;
                text: root.cancel-label;
                clicked => { root.cancel(); }
            }
            GoldButton {
                hug: true;
                min-width: 128px;
                min-height: 36px;
                horizontal-stretch: 0;
                primary: true;
                font-size: Theme.text-md;
                text: root.confirm-label;
                clicked => { root.confirm(); }
            }
        }
    }

    ExposeLayer {
        flip: root.expose-flip;
    }
}
