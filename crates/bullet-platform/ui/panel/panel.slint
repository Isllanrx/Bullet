import { Theme, ExposeLayer, GoldButton, Wordmark, StatusDot, Halo } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";
import { PanelLabels, PanelCheckRow, PanelSkinStatRow, PanelAction } from "panel_types.slint";
import { Section, PanelTab, CheckRow, Toggle, Notice, PowerCard, AllClearBanner } from "panel_parts.slint";
import { ModeCard, RepairBanner, LanguagePill, LanguagePicker } from "panel_mode.slint";
import { StatsCard } from "panel_stats.slint";

export component ControlPanel inherits Window {
    in property <bool> expose-flip;
    in property <PanelLabels> labels;
    in property <string> lang-code: "EN";
    in-out property <bool> lang-open: false;
    in property <string> status;
    in property <string> party-line;
    in property <bool> in-room;
    in property <bool> random-skin;
    in property <bool> light-loading;
    in property <bool> in-client-ui;
    in property <bool> injection;
    in property <bool> auto-accept;
    in property <bool> autostart;
    in property <bool> reduce-motion;
    in property <bool> notifications;
    in property <string> update-line;
    in property <string> ltk-update-line;
    in property <int> attention;
    in property <[PanelCheckRow]> checks;
    in property <int> stats-wins;
    in property <int> stats-losses;
    in property <int> stats-winrate;
    in property <[PanelSkinStatRow]> stats-rows;
    in property <bool> repair-skins-busy;
    in property <bool> repair-client-busy;
    in property <int> repair-state;
    in property <string> repair-message;
    in-out property <int> tab;
    callback action(PanelAction);
    callback select-language(string);
    callback copy-text(string);
    title: "Bullet";
    icon: @image-url("../assets/logo.png");
    preferred-width: 480px;
    preferred-height: 600px;
    min-width: 400px;
    min-height: 440px;
    background: Theme.backdrop;
    default-font-family: Theme.sans;

    FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape && root.lang-open { root.lang-open = false; return accept; }
            if event.modifiers.control && event.text == "1" { root.tab = 0; return accept; }
            if event.modifiers.control && event.text == "2" { root.tab = 1; return accept; }
            if event.modifiers.control && event.text == "3" { root.tab = 2; return accept; }
            if event.modifiers.control && event.text == "4" { root.tab = 3; return accept; }
            reject
        }
    }

    VerticalLayout {
        Rectangle {
            vertical-stretch: 0;
            min-height: 92px;
            Halo { x: -44px; y: -52px; }
            HorizontalLayout {
                padding-left: 22px; padding-right: 22px; padding-top: 20px; padding-bottom: 16px;
                spacing: 14px;
                Image { source: @image-url("../assets/logo-56.png"); width: 52px; height: 52px; }
                VerticalLayout {
                    alignment: center; horizontal-stretch: 1; spacing: 4px;
                    Wordmark { version: root.labels.version; size: 12px; }
                    HorizontalLayout {
                        spacing: 8px; alignment: start;
                        VerticalLayout { alignment: center; StatusDot { online: root.injection && root.attention == 0; } }
                        Text {
                            text: root.status; color: Theme.gold-bright; font-family: Theme.serif;
                            font-size: 17px; font-weight: 700; wrap: word-wrap; horizontal-stretch: 1;
                        }
                    }
                }
                VerticalLayout {
                    alignment: start;
                    LanguagePill {
                        code: root.lang-code; heading: root.labels.language-label; open: root.lang-open;
                        toggle => { root.lang-open = !root.lang-open; }
                    }
                }
            }
        }
        if root.lang-open: HorizontalLayout {
            vertical-stretch: 0; padding-left: 20px; padding-right: 20px; padding-bottom: 10px;
            LanguagePicker {
                heading: root.labels.language-label; active-code: root.lang-code;
                selected(code) => { root.lang-open = false; root.select-language(code); }
            }
        }
        HorizontalLayout {
            vertical-stretch: 0; padding-left: 20px; padding-right: 20px;
            track := Rectangle {
                height: 44px; border-radius: 12px; border-width: 1px;
                border-color: Theme.surface-line; background: #09101b;
                Rectangle {
                    y: 4px; height: parent.height - 8px; border-radius: 9px; border-width: 1px;
                    border-color: Theme.gold-dim;
                    background: @linear-gradient(180deg, #273750 0%, #192538 100%);
                    x: root.tab == 0 ? home.x : root.tab == 1 ? skins.x : root.tab == 2 ? party.x : support.x;
                    width: root.tab == 0 ? home.width : root.tab == 1 ? skins.width : root.tab == 2 ? party.width : support.width;
                    animate x, width { duration: Theme.dur-slow; easing: ease-out-quart; }
                }
                HorizontalLayout {
                    padding: 4px; spacing: 2px;
                    home := PanelTab {
                        text: root.labels.tab-home;
                        icon: "M 2.5 7.5 L 8 2.5 L 13.5 7.5 M 4 6.5 L 4 13.5 L 12 13.5 L 12 6.5 M 6.8 13.5 L 6.8 9.8 L 9.2 9.8 L 9.2 13.5";
                        active: root.tab == 0; clicked => { root.tab = 0; }
                    }
                    skins := PanelTab {
                        text: root.labels.tab-options;
                        icon: "M 2 4.5 L 14 4.5 M 2 8 L 14 8 M 2 11.5 L 14 11.5 M 5.5 3 L 5.5 6 M 10.5 6.5 L 10.5 9.5 M 6.5 10 L 6.5 13";
                        active: root.tab == 1; clicked => { root.tab = 1; }
                    }
                    party := PanelTab {
                        text: root.labels.tab-party;
                        icon: "M 5.8 7.2 A 2.3 2.3 0 1 1 5.79 7.2 Z M 11.2 7.6 A 1.9 1.9 0 1 1 11.19 7.6 Z M 1.8 13.5 C 1.8 11 3.6 9.8 5.8 9.8 C 8 9.8 9.8 11 9.8 13.5 M 10 10.4 C 12 10.4 14 11.4 14 13.5";
                        active: root.tab == 2; clicked => { root.tab = 2; }
                    }
                    support := PanelTab {
                        text: root.labels.tab-help;
                        icon: "M 8 2 L 13.5 4.2 L 13.5 8.4 C 13.5 11.4 11 13.2 8 14.2 C 5 13.2 2.5 11.4 2.5 8.4 L 2.5 4.2 Z M 6.2 8.2 L 7.5 9.5 L 10.2 6.8";
                        active: root.tab == 3; badge: root.attention; clicked => { root.tab = 3; }
                    }
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            scroll := ScrollView {
                width: parent.width; height: parent.height;
                VerticalLayout {
                    width: scroll.visible-width; alignment: start;
                    padding: 20px; padding-top: 16px; spacing: 12px;
                    if root.tab == 0: VerticalLayout {
                        spacing: 12px;
                        if root.update-line != "": Notice {
                            line: root.update-line; action: root.labels.update-download;
                            activated => { root.action(PanelAction.open-release); }
                        }
                        if root.ltk-update-line != "": Notice {
                            line: root.ltk-update-line; action: root.labels.ltk-update-download;
                            activated => { root.action(PanelAction.open-ltk-release); }
                        }
                        if root.attention > 0: Notice {
                            warning: true; line: root.labels.attention + " " + root.attention;
                            action: root.labels.see-diagnostics; activated => { root.tab = 3; }
                        }
                        PowerCard {
                            label: root.labels.injection; hint: root.labels.injection-hint;
                            checked: root.injection; toggled => { root.action(PanelAction.toggle-injection); }
                        }
                        ModeCard {
                            heading: root.labels.mode-title; window-label: root.labels.mode-window;
                            client-label: root.labels.mode-client; in-client: root.in-client-ui;
                            toggled => { root.action(PanelAction.toggle-in-client-ui); }
                        }
                        StatsCard {
                            heading: root.labels.stats-title; empty-text: root.labels.stats-empty;
                            games-suffix: root.labels.stats-games; wins-short: root.labels.stats-wins-short;
                            losses-short: root.labels.stats-losses-short; wins: root.stats-wins;
                            losses: root.stats-losses; winrate: root.stats-winrate; rows: root.stats-rows;
                        }
                        if root.update-line == "" && root.ltk-update-line == "" && root.attention == 0: AllClearBanner {
                            text: root.labels.all-clear;
                        }
                    }
                    if root.tab == 1: VerticalLayout {
                        spacing: 12px;
                        Section {
                            heading: root.labels.section-match;
                            icon: "M 8 1.8 L 9.6 6.2 L 14.2 7.8 L 9.6 9.4 L 8 14.2 L 6.4 9.4 L 1.8 7.8 L 6.4 6.2 Z";
                            Toggle {
                                divider: false; label: root.labels.random-skin; hint: root.labels.random-skin-hint;
                                checked: root.random-skin; toggled => { root.action(PanelAction.toggle-random-skin); }
                            }
                            Toggle {
                                label: root.labels.light-loading; hint: root.labels.light-loading-hint;
                                checked: root.light-loading; toggled => { root.action(PanelAction.toggle-light-loading); }
                            }
                            Toggle {
                                label: root.labels.auto-accept; checked: root.auto-accept;
                                toggled => { root.action(PanelAction.toggle-auto-accept); }
                            }
                            Toggle {
                                label: root.labels.autostart; checked: root.autostart;
                                toggled => { root.action(PanelAction.toggle-autostart); }
                            }
                        }
                        Section {
                            heading: root.labels.section-interface;
                            icon: "M 2 3 L 14 3 L 14 13 L 2 13 Z M 2 6.2 L 14 6.2 M 6.2 6.2 L 6.2 13";
                            Toggle {
                                divider: false; label: root.labels.notifications; hint: root.labels.notifications-hint;
                                checked: root.notifications; toggled => { root.action(PanelAction.toggle-notifications); }
                            }
                            Toggle {
                                label: root.labels.reduce-motion; hint: root.labels.reduce-motion-hint;
                                checked: root.reduce-motion; toggled => { root.action(PanelAction.toggle-reduce-motion); }
                            }
                        }
                        if root.repair-message != "": RepairBanner {
                            state: root.repair-state; text: root.repair-message;
                            copy-label: root.labels.copy-error; copied-label: root.labels.copied; logs-label: root.labels.open-logs;
                            copy-error => { root.copy-text(root.repair-message); }
                            open-logs => { root.action(PanelAction.open-logs); }
                        }
                        GoldButton {
                            text: root.labels.reset-defaults;
                            icon: "M 3 8 A 5 5 0 1 1 4.8 11.8 M 3 4.2 L 3 8 L 6.8 8";
                            clicked => { root.action(PanelAction.reset-defaults); }
                        }
                    }
                    if root.tab == 2: Section {
                        heading: root.labels.tab-party;
                        icon: "M 5.8 7.2 A 2.3 2.3 0 1 1 5.79 7.2 Z M 11.2 7.6 A 1.9 1.9 0 1 1 11.19 7.6 Z M 1.8 13.5 C 1.8 11 3.6 9.8 5.8 9.8 C 8 9.8 9.8 11 9.8 13.5 M 10 10.4 C 12 10.4 14 11.4 14 13.5";
                        HorizontalLayout {
                            spacing: 10px; alignment: start;
                            VerticalLayout { alignment: center; StatusDot { online: root.in-room; } }
                            Text {
                                text: root.party-line != "" ? root.party-line : root.labels.party-hint;
                                color: root.party-line != "" ? Theme.gold-bright : Theme.muted;
                                font-size: Theme.text-base; font-weight: root.party-line != "" ? 600 : 400;
                                wrap: word-wrap; horizontal-stretch: 1;
                            }
                        }
                        if root.party-line != "": Text {
                            text: root.labels.party-hint; color: Theme.muted; font-size: Theme.text-sm; wrap: word-wrap;
                        }
                        if !root.in-room: HorizontalLayout {
                            spacing: 8px;
                            GoldButton { text: root.labels.party-create; icon: "M 8 3 L 8 13 M 3 8 L 13 8"; primary: true; clicked => { root.action(PanelAction.party-create); } }
                            GoldButton { text: root.labels.party-join; icon: "M 6 3 L 13 3 L 13 13 L 6 13 M 2 8 L 10 8 M 7.5 5.5 L 10 8 L 7.5 10.5"; clicked => { root.action(PanelAction.party-join); } }
                        }
                        if root.in-room: GoldButton { text: root.labels.party-leave; icon: "M 9 3 L 3 3 L 3 13 L 9 13 M 14 8 L 6 8 M 11.5 5.5 L 14 8 L 11.5 10.5"; danger: true; clicked => { root.action(PanelAction.party-leave); } }
                    }
                    if root.tab == 3: VerticalLayout {
                        spacing: 12px;
                        Section {
                            heading: root.labels.section-diagnostics;
                            icon: "M 8 2 L 13.5 4.2 L 13.5 8.4 C 13.5 11.4 11 13.2 8 14.2 C 5 13.2 2.5 11.4 2.5 8.4 L 2.5 4.2 Z M 6.2 8.2 L 7.5 9.5 L 10.2 6.8";
                            VerticalLayout { spacing: 8px; for check in root.checks: CheckRow { check: check; } }
                            Rectangle { height: 1px; background: Theme.surface-line; }
                            Text { text: root.labels.mark-problem-hint; color: Theme.muted; font-size: Theme.text-sm; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 8px;
                                GoldButton {
                                    text: root.repair-skins-busy ? root.labels.repair-running : root.labels.repair-skins;
                                    icon: "M 3 8 A 5 5 0 1 1 4.8 11.8 M 3 4.2 L 3 8 L 6.8 8";
                                    enabled: !root.repair-skins-busy; clicked => { root.action(PanelAction.repair-skins); }
                                }
                                GoldButton {
                                    text: root.repair-client-busy ? root.labels.repair-running : root.labels.repair-client;
                                    icon: "M 12.8 4.6 A 3.4 3.4 0 0 1 8.5 8.9 L 4 13.4 L 2.6 12 L 7.1 7.5 A 3.4 3.4 0 0 1 11.4 3.2 L 9.5 5.1 L 10.9 6.5 Z";
                                    enabled: !root.repair-client-busy; clicked => { root.action(PanelAction.repair-client); }
                                }
                            }
                            GoldButton { text: root.labels.pick-ltk; icon: "M 2 4.2 L 6.4 4.2 L 8 5.8 L 14 5.8 L 14 13 L 2 13 Z"; clicked => { root.action(PanelAction.pick-ltk-manager); } }
                            if root.repair-message != "": RepairBanner {
                                state: root.repair-state; text: root.repair-message;
                                copy-label: root.labels.copy-error; copied-label: root.labels.copied; logs-label: root.labels.open-logs;
                                copy-error => { root.copy-text(root.repair-message); }
                                open-logs => { root.action(PanelAction.open-logs); }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                GoldButton { text: root.labels.mark-problem; icon: "M 8 2.2 L 14.2 13.2 L 1.8 13.2 Z M 8 6.4 L 8 9.6 M 8 11.4 L 8 11.8"; clicked => { root.action(PanelAction.mark-problem); } }
                                GoldButton { text: root.labels.export-diagnostics; icon: "M 8 11 L 8 2.5 M 4.8 5.8 L 8 2.5 L 11.2 5.8 M 3 13.5 L 13 13.5"; primary: true; clicked => { root.action(PanelAction.export-diagnostics); } }
                            }
                        }
                        Section {
                            heading: root.labels.section-folders;
                            icon: "M 2 4.2 L 6.4 4.2 L 8 5.8 L 14 5.8 L 14 13 L 2 13 Z";
                            HorizontalLayout {
                                spacing: 8px;
                                GoldButton { text: root.labels.open-mods; icon: "M 8 2 L 14 5.2 L 8 8.4 L 2 5.2 Z M 2 8.2 L 8 11.4 L 14 8.2"; clicked => { root.action(PanelAction.open-mods); } }
                                GoldButton { text: root.labels.open-logs; icon: "M 4 2 L 10 2 L 13 5 L 13 14 L 4 14 Z M 6 8 L 11 8 M 6 11 L 10 11"; clicked => { root.action(PanelAction.open-logs); } }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                GoldButton { text: root.labels.open-tools; icon: "M 8 2 L 13.5 5 L 13.5 11 L 8 14 L 2.5 11 L 2.5 5 Z M 2.5 5 L 8 8 L 13.5 5 M 8 8 L 8 14"; clicked => { root.action(PanelAction.open-tools); } }
                                GoldButton { text: root.labels.restore-mods; icon: "M 3 8 A 5 5 0 1 1 4.8 11.8 M 3 4.2 L 3 8 L 6.8 8"; clicked => { root.action(PanelAction.restore-mods); } }
                            }
                        }
                    }
                }
            }
            if -scroll.content-y + scroll.visible-height < scroll.content-height - 2px: Rectangle {
                y: parent.height - self.height; height: 32px;
                background: @linear-gradient(180deg, #060a1000 0%, #060a10f2 100%);
            }
        }
        Rectangle { vertical-stretch: 0; height: 1px; background: Theme.surface-line; }
        HorizontalLayout {
            vertical-stretch: 0; padding-top: 12px; padding-bottom: 14px; padding-left: 20px; padding-right: 20px; spacing: 8px;
            GoldButton { text: root.labels.about; icon: "M 8 2 A 6 6 0 1 1 7.99 2 Z M 8 7 L 8 11.2 M 8 4.8 L 8 5.2"; hug: true; horizontal-stretch: 0; clicked => { root.action(PanelAction.about); } }
            GoldButton { text: root.labels.open-project; icon: "M 8 2 L 9.8 5.8 L 14 6.4 L 11 9.3 L 11.7 13.5 L 8 11.5 L 4.3 13.5 L 5 9.3 L 2 6.4 L 6.2 5.8 Z"; hug: true; horizontal-stretch: 0; clicked => { root.action(PanelAction.open-project); } }
            Rectangle { horizontal-stretch: 1; }
            GoldButton { text: root.labels.quit; icon: "M 8 2 L 8 7.5 M 4.8 4.2 A 5.2 5.2 0 1 0 11.2 4.2"; danger: true; hug: true; horizontal-stretch: 0; clicked => { root.action(PanelAction.quit); } }
        }
    }

    ExposeLayer { flip: root.expose-flip; }
}
