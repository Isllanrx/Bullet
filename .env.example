# Bullet environment variables — reference only.
#
# Bullet does not load a .env file: it reads these from the Windows environment when it starts. Every one
# is optional; leave them unset for the normal behavior. To set one:
#
#   PowerShell, this session only:   $env:BULLET_LOG = "debug"; & "C:\Program Files\Bullet\bullet.exe"
#   Permanently, for your user:      setx BULLET_LOG debug        (then restart Bullet)
#   To remove it again:              [Environment]::SetEnvironmentVariable("BULLET_LOG", $null, "User")
#
# Never put secrets here; none of these variables is one.

# Log detail written to %LOCALAPPDATA%\Bullet\logs.
# info (default) | debug | trace, or a filter such as bullet_lcu=trace. Overrides RUST_LOG.
# debug also makes the injector host log its own details.
BULLET_LOG=info

# Party relay to use instead of the built-in default. Must be wss:// (ws:// is accepted only for
# 127.0.0.1 / localhost while testing a local relay). Takes precedence over party.json.
# BULLET_RELAY_URL=wss://your-relay.example.workers.dev

# Download a skin library in the background from a GitHub repository you choose, as owner/repo.
# Off when unset; Bullet has no built-in source.
# BULLET_SKIN_SYNC=owner/repo

# Advanced: numeric hook flags passed to the injector host (bit field). Leave unset unless you are
# diagnosing the injector. Default: 4.
# BULLET_PATCHER_FLAGS=4
